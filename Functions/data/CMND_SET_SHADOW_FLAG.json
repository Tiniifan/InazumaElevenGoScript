{
  "name": "CMND_SET_SHADOW_FLAG",
  "kind": "native",
  "category": "chara",
  "description": {
    "en": "Shows or hides a character's drop shadow."
  },
  "params": [
    {
      "name": "handle",
      "type": "handle",
      "description": {
        "en": "Character handle to configure."
      }
    },
    {
      "name": "enabled",
      "type": "boolean",
      "description": {
        "en": "True to show the shadow, false to hide it."
      }
    }
  ],
  "returns": {
    "type": "boolean",
    "description": {
      "en": "Always true."
    }
  },
  "example": {
    "source": "real",
    "code": "// Hide a character's shadow for this shot\nCMND_SET_SHADOW_FLAG(hTenmaL, false);"
  }
}
