{
  "name": "CMND_AVATAR_EVOLUTION",
  "kind": "native",
  "category": "party",
  "description": {
    "en": "Evolves a character's currently attached avatar (keshin/mascot) into the given avatar."
  },
  "params": [
    {
      "name": "charaHandle",
      "type": "handle",
      "description": {
        "en": "Character handle whose avatar evolves."
      }
    },
    {
      "name": "avatarId",
      "type": "integer",
      "description": {
        "en": "ID of the evolved avatar."
      }
    }
  ],
  "returns": {
    "type": "boolean|null",
    "description": {
      "en": "True once the call has taken effect; null if the call was invalid (e.g. too few arguments, or required engine/script state not ready)."
    }
  },
  "example": {
    "source": "real",
    "code": "// Evolve a character's avatar\nCMND_AVATAR_EVOLUTION(_chr, _avt);"
  }
}
