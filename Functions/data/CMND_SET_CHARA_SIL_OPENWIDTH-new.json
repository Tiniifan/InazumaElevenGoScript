{
  "name": "CMND_SET_CHARA_SIL_OPENWIDTH",
  "kind": "native",
  "category": "chara",
  "description": {
    "en": "Sets another width value of a character's silhouette (by the name, the width when open; not traced further). The silhouette is the outline drawn around a character. No shipped script calls it."
  },
  "params": [
    {
      "name": "hChara",
      "type": "handle",
      "required": true,
      "description": {
        "en": "Character handle."
      }
    },
    {
      "name": "width",
      "type": "float",
      "required": true,
      "description": {
        "en": "Width value."
      }
    }
  ],
  "returns": {
    "type": "null",
    "description": {
      "en": "null in every case (also when the character is not found)."
    }
  },
  "examples": [
    {
      "case": "Example (not found in script_clean/; invented)",
      "source": "invented",
      "code": "CMND_SET_CHARA_SIL_OPENWIDTH(hTenmaL, 0.004);"
    }
  ]
}
