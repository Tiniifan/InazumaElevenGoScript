{
  "name": "WaitCamCtrlMoving",
  "kind": "ev_main",
  "category": "camera",
  "description": {
    "en": "Waits until the camera move started with CamCtrlMoveTo is finished: it loops on IsCamCtrlMove() with suspend(). The camera handle argument is not used."
  },
  "params": [
    {
      "name": "_hcam",
      "type": "handle",
      "required": true,
      "description": {
        "en": "Camera handle (not used)."
      }
    }
  ],
  "returns": {
    "type": "null",
    "description": {
      "en": "Always null (no return statement)."
    }
  },
  "examples": [
    {
      "case": "Waiting for the camera (real usage, from ev42010200.nut)",
      "source": "real",
      "code": "CamCtrlMoveTo(hCam, 80, [-86.699997, 81.699997, -55.900002, -86.699997, 3.5, -159.7]);\nWaitEvLowMdlMoving(hTenmaL);\nWaitCamCtrlMoving(hCam);"
    }
  ]
}
