{
  "name": "CMND_SET_SHADOW_FLAG",
  "kind": "native",
  "category": "chara",
  "description": {
    "en": "Shows (true) or hides (false) a character's shadow."
  },
  "params": [
    {
      "name": "hChara",
      "type": "handle",
      "required": true,
      "description": {
        "en": "Character handle."
      }
    },
    {
      "name": "on",
      "type": "boolean",
      "required": true,
      "description": {
        "en": "true to show the shadow."
      }
    }
  ],
  "returns": {
    "type": "boolean|null",
    "description": {
      "en": "true once set, false if the object is not found.\nnull if the script system is not ready or fewer than 2 arguments are given."
    }
  },
  "examples": [
    {
      "case": "No shadows for an HQ event (real usage, from ev42123400.nut)",
      "source": "real",
      "code": "CMND_SET_SHADOW_FLAG(hTenmaH, false);\nCMND_SET_SHADOW_FLAG(hKirinoH, false);"
    }
  ]
}
